---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Service from '../components/Service.astro';
import Audience from '../components/Audience.astro';
import Solutions from '../components/Solutions.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import StickyWhatsApp from '../components/StickyWhatsApp.astro';
---

<BaseLayout>
  <Header />

  <main id="main">
    <Hero />
    <Service />
    <Audience />
    <Solutions />
    {/* סעיף תיק העבודות ייכנס כאן בעתיד — ראו ההערה בסוף Solutions.astro */}
    <FinalCta />
  </main>

  <Footer />
  <StickyWhatsApp />
</BaseLayout>
