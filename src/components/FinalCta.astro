---
import { FINAL_CTA } from '../config/content.ts';
import { CONTACT } from '../config/site.ts';
import WhatsAppButton from './WhatsAppButton.astro';
---

<section id="contact" class="scroll-mt-20 bg-canvas px-5 py-16 sm:px-8 sm:py-20 lg:py-24">
  <div
    class="mx-auto w-full max-w-5xl rounded-3xl bg-brand-dark px-7 py-14 text-center sm:px-12 sm:py-16"
  >
    <h2 class="text-section font-bold text-white">{FINAL_CTA.title}</h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-brand-tint">
      {FINAL_CTA.body}
    </p>

    <div class="mt-9 flex flex-col items-center gap-4">
      <WhatsAppButton
        label={FINAL_CTA.ctaLabel}
        variant="inverse"
        class="w-full justify-center sm:w-auto"
      />
      <p class="text-sm text-brand-tint">
        או בטלפון <span dir="ltr">{CONTACT.whatsappNumberDisplay}</span>
      </p>
    </div>
  </div>
</section>
