---
import { WHATSAPP_URL } from '../config/site.ts';
import WhatsAppIcon from './WhatsAppIcon.astro';

interface Props {
  label: string;
  /** `primary` — כפתור מלא, `inverse` — כפתור בהיר על רקע כהה, `compact` — גרסה קטנה להדר. */
  variant?: 'primary' | 'inverse' | 'compact';
  class?: string;
}

const { label, variant = 'primary', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2.5 rounded-full font-semibold ' +
  'transition-[background-color,transform,box-shadow] duration-200 motion-safe:hover:-translate-y-0.5';

const variants = {
  primary:
    'bg-brand px-7 py-4 text-base text-white shadow-lg shadow-brand/25 hover:bg-brand-dark sm:text-lg',
  inverse:
    'bg-white px-7 py-4 text-base text-brand-dark shadow-lg shadow-black/10 hover:bg-brand-tint sm:text-lg',
  compact: 'bg-brand px-5 py-2.5 text-sm text-white hover:bg-brand-dark',
} as const;

const iconSize = variant === 'compact' ? 'h-4.5 w-4.5' : 'h-5.5 w-5.5';
---

<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[base, variants[variant], className]}
>
  <WhatsAppIcon class={iconSize} />
  <span>{label}</span>
</a>
