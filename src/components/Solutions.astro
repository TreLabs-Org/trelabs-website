---
import { SOLUTIONS } from '../config/content.ts';
import Section from './Section.astro';
---

<Section id="solutions" eyebrow={SOLUTIONS.eyebrow} title={SOLUTIONS.title} tone="alt">
  <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">{SOLUTIONS.intro}</p>

  <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      SOLUTIONS.items.map((item) => (
        <li class="rounded-2xl border border-line bg-canvas p-7 transition-shadow duration-200 hover:shadow-md hover:shadow-ink/5">
          <h3 class="text-xl font-bold text-ink">{item.name}</h3>
          <p class="mt-3 leading-relaxed text-ink-soft">{item.body}</p>
        </li>
      ))
    }
  </ul>

  <p class="mt-10 max-w-2xl text-lg leading-relaxed text-ink-soft">{SOLUTIONS.outro}</p>
</Section>

