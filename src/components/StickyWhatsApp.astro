---
import { WHATSAPP_URL } from '../config/site.ts';
import { HERO } from '../config/content.ts';
import WhatsAppIcon from './WhatsAppIcon.astro';

/**
 * כפתור צף למובייל — נגיש לאורך כל הגלילה.
 * בדסקטופ הכפתור הקבוע נמצא בהדר הדביק, ולכן הצף מוסתר מ-md ומעלה.
 */
---

<a
  href={WHATSAPP_URL}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={HERO.ctaLabel}
  class="fixed bottom-[max(1rem,env(safe-area-inset-bottom))] end-4 z-50 inline-flex items-center gap-2.5 rounded-full bg-brand py-3.5 ps-4 pe-5 font-semibold text-white shadow-xl shadow-brand/30 transition-colors duration-200 hover:bg-brand-dark md:hidden"
>
  <WhatsAppIcon class="h-6 w-6" />
  <span class="text-[0.95rem]">וואטסאפ</span>
</a>
