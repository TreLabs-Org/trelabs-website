---
import { CONTACT, SITE, WHATSAPP_URL } from '../config/site.ts';
import { FOOTER } from '../config/content.ts';
import Wordmark from './Wordmark.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-canvas-alt px-5 pt-12 pb-24 sm:px-8 sm:pb-12">
  <div
    class="mx-auto flex w-full max-w-5xl flex-col gap-6 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <Wordmark />
      <p class="mt-3 text-sm text-ink-soft">{FOOTER.tagline}</p>
    </div>

    <div class="flex flex-col gap-2 text-sm text-ink-soft sm:items-end">
      <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-dark hover:underline">
        וואטסאפ · <span dir="ltr">{CONTACT.whatsappNumberDisplay}</span>
      </a>
      <p>כל הזכויות שמורות <span dir="ltr">© {year} {SITE.name}</span></p>
    </div>
  </div>
</footer>
