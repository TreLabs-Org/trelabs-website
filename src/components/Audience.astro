---
import { AUDIENCE } from '../config/content.ts';
import Section from './Section.astro';
---

<Section id="audience" eyebrow={AUDIENCE.eyebrow} title={AUDIENCE.title}>
  <ul class="mt-9 grid gap-x-10 gap-y-5 sm:grid-cols-2">
    {
      AUDIENCE.items.map((item) => (
        <li class="flex items-start gap-3.5">
          <span
            class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-brand-tint text-brand"
            aria-hidden="true"
          >
            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 10.5 8 14.5 16 6" />
            </svg>
          </span>
          <p class="text-lg leading-relaxed text-ink-soft">{item}</p>
        </li>
      ))
    }
  </ul>
</Section>
