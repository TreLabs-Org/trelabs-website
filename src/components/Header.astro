---
import WhatsAppButton from './WhatsAppButton.astro';
import Wordmark from './Wordmark.astro';
---

<header
  class="site-header sticky top-0 z-40 border-b border-line/70 bg-canvas/85 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between px-5 sm:px-8">
    <a href="#top" class="rounded-lg" aria-label="TreLabs — לראש הדף">
      <Wordmark />
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="ניווט ראשי">
      <a
        href="#service"
        class="text-sm font-medium text-ink-soft transition-colors hover:text-ink">מה אנחנו עושים</a
      >
      <a
        href="#audience"
        class="text-sm font-medium text-ink-soft transition-colors hover:text-ink">למי זה מתאים</a
      >
      <a
        href="#solutions"
        class="text-sm font-medium text-ink-soft transition-colors hover:text-ink">סוגי פתרונות</a
      >
      <WhatsAppButton label="דברו איתנו" variant="compact" />
    </nav>
  </div>
</header>

<style>
  /* Safari עד גרסה 18 דורש את הקידומת, ולכן היא נוספת כאן במפורש */
  .site-header {
    -webkit-backdrop-filter: blur(12px);
  }

  @supports (backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px)) {
    .site-header {
      background-color: color-mix(in oklab, var(--color-canvas) 72%, transparent);
    }
  }
</style>
