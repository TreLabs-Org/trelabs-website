---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<!-- הלוגו הוא צירוף לטיני, ולכן נשמר בכיוון LTR גם בתוך דף RTL -->
<span class:list={['inline-flex items-center gap-2', className]} dir="ltr">
  <svg
    class="h-8 w-8 shrink-0"
    viewBox="0 0 64 64"
    role="presentation"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="64" height="64" rx="14" class="fill-brand"></rect>
    <path d="M18 20h28v7.5H38.5V46h-9V27.5H18V20z" fill="#ffffff"></path>
  </svg>
  <span class="text-lg font-bold tracking-tight text-ink">TreLabs</span>
</span>
