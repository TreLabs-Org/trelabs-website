---
/**
 * מעטפת אחידה לסעיפי הדף — שומרת על מרווחים והיררכיה זהים בכל הסעיפים,
 * וכך הוספת סעיף חדש (למשל תיק עבודות) לא דורשת עיצוב מחדש.
 */
interface Props {
  id: string;
  /** כותרת קטנה מעל הכותרת הראשית. */
  eyebrow?: string;
  title?: string;
  /** רקע חלופי לסירוגין בין הסעיפים. */
  tone?: 'canvas' | 'alt';
  class?: string;
}

const { id, eyebrow, title, tone = 'canvas', class: className = '' } = Astro.props;
---

<section
  id={id}
  class:list={[
    'scroll-mt-20 border-b border-line/70 px-5 py-16 sm:px-8 sm:py-20 lg:py-28',
    tone === 'alt' ? 'bg-canvas-alt' : 'bg-canvas',
    className,
  ]}
>
  <div class="mx-auto w-full max-w-5xl">
    {
      (eyebrow || title) && (
        <header class="max-w-3xl">
          {eyebrow && (
            <p class="mb-3 text-sm font-semibold tracking-wide text-brand">{eyebrow}</p>
          )}
          {title && <h2 class="text-section font-bold text-ink">{title}</h2>}
        </header>
      )
    }
    <slot />
  </div>
</section>
