---
import { SERVICE } from '../config/content.ts';
import Section from './Section.astro';
---

<Section id="service" eyebrow={SERVICE.eyebrow} title={SERVICE.title} tone="alt">
  <div class="mt-7 max-w-3xl space-y-5">
    {
      SERVICE.paragraphs.map((paragraph) => (
        <p class="text-lg leading-relaxed text-ink-soft">{paragraph}</p>
      ))
    }
  </div>

  <ul class="mt-12 grid gap-6 sm:grid-cols-3">
    {
      SERVICE.points.map((point, index) => (
        <li class="rounded-2xl border border-line bg-canvas p-6">
          <span class="text-sm font-bold text-brand">{`0${index + 1}`}</span>
          <h3 class="mt-2 text-lg font-bold text-ink">{point.title}</h3>
          <p class="mt-2 leading-relaxed text-ink-soft">{point.body}</p>
        </li>
      ))
    }
  </ul>
</Section>
